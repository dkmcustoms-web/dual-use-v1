# Neon Postgres connection string
# Get from https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxxxx.neon.tech/dbname?sslmode=require

# OpenSanctions API key
# Get from https://www.opensanctions.org/account/
OPENSANCTIONS_API_KEY=your-key-here

# Optional: OpenSanctions API base (default works fine)
# OPENSANCTIONS_API_BASE=https://api.opensanctions.org
